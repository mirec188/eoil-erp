# eOil ERP — local environment variables (example, safe to commit).
#
# With Docker Compose these are read from a git-ignored `.env` next to compose.yaml
# (defaults are in compose.yaml). Without Docker, src/bootstrap.php loads `.env`
# only when APP_ENV is not already set. Never put real tokens into this file.

# dev | test | prod. An unset APP_ENV means prod, which this slice refuses to serve.
APP_ENV=dev
APP_DEBUG=true

# Catalog source, required and explicit:
#   fixture = synthetic demo data (visibly marked "Ukážkové údaje"; refused in prod)
#   http    = HTTP adapter for the proposed eOil ERP API (contract draft for M2;
#             the endpoint does not exist in eOil yet)
CATALOG_SOURCE=fixture

# Only for CATALOG_SOURCE=http. No default URL of any real eOil system exists.
# HTTPS is required; plain HTTP is accepted only with APP_ENV=test and a loopback host.
CATALOG_API_BASE_URL=
# Bearer token sent only in the Authorization header. Keep it out of git and logs.
CATALOG_API_TOKEN=
# Request timeout in seconds, (0, 30]. Default 5.
CATALOG_API_TIMEOUT=5
