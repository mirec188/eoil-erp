# eOil ERP — local environment variables (example, safe to commit).
#
# With Docker Compose these are read from a git-ignored `.env` next to compose.yaml
# (defaults are in compose.yaml). Without Docker, src/bootstrap.php loads `.env`
# only when APP_ENV is not already set. Never put real secrets into this file.

# Compose project name and loopback host port (lets two checkouts run side by side).
COMPOSE_PROJECT_NAME=eoil-erp
ERP_HTTP_PORT=8088

# dev | test | prod. An unset APP_ENV means prod, which this slice refuses to serve.
APP_ENV=dev
APP_DEBUG=true

# Catalog source, required and explicit:
#   fixture = synthetic demo data, no sign-in (refused in prod)
#   http    = real eOil data through the eOil API; every page requires sign-in through eOil
CATALOG_SOURCE=fixture
# Request timeout in seconds, (0, 30]. Default 5.
CATALOG_API_TIMEOUT=5

# Only for CATALOG_SOURCE=http. There is no default URL of any real eOil system.
# HTTPS is required; plain HTTP only in APP_ENV=dev for localhost/127.0.0.1/host.docker.internal
# and in APP_ENV=test for loopback.
# Server-side base URL of the eOil backend (catalog API and token endpoint), as the ERP container sees it:
EOIL_API_BASE_URL=
# Browser-facing URL of the eOil sign-in page:
EOIL_AUTHORIZE_URL=
EOIL_CLIENT_ID=eoil-erp
# Client secret registered in eOil (backend/runtime/erp_client_secret). At least 32 characters.
EOIL_CLIENT_SECRET=
# Absolute callback URL of this ERP, registered exactly in eOil (backend/runtime/erp_redirect_uris).
ERP_REDIRECT_URI=
